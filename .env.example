# Wann-der environment. Copy to .env and fill in. Never commit .env.
# See SPIKE.md for what each unblocks.

# --- Supabase (EU/Frankfurt project). Leave empty to run on demo fixtures. ---
# Local: `pnpm db:start` prints both values (see supabase/README.md).
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Server-only and currently unused: every app query runs under RLS with the anon key.
SUPABASE_SERVICE_ROLE_KEY=

# --- Super-admin allowlist (comma-separated emails; same pattern as tkRaum ADR-0005) ---
ADMIN_EMAILS=

# --- Geocoding (EU/GDPR-clean). Nominatim needs no key; MapTiler does. ---
GEOCODER=nominatim
MAPTILER_KEY=

# --- Translation (DeepL — German/EU). Enabled later, not needed for the spike. ---
DEEPL_API_KEY=

# --- Bot deterrence (Cloudflare Turnstile). Enabled later, not needed for the spike. ---
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
